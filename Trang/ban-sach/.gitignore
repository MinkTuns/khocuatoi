# BookStore - Tệp Gitignore

# Operating System
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE & Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.phpunit.cache/

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Dependencies
vendor/
node_modules/

# Build & Dist
dist/
build/
*.min.js
*.min.css

# Backup files
*.bak
*.backup
*.tmp

# OS specific
._*
.AppleDouble
.LSOverride
.localized

# Database backups
*.sql.bak
*.sql.gz
*.sql.zip

# Uploaded files (keep structure, ignore content)
public/images/books/*
!public/images/books/.gitkeep

# Cache
.cache/
*.cache

# Composer
composer.lock

# NPM
package-lock.json
yarn.lock

# Local config overrides
config.local.php
database.local.php
